# Allowlist: only template files are tracked. Client folders stay local.
# To version client work, make your own PRIVATE repo and edit this file there.
/*
!/.gitignore
!/README.md
!/CLAUDE.md
!/LICENSE
!/.env.example
!/.mcp.json.example
!/s2.code-workspace
!/bin/
!/_meta/
!/.claude/
!/.vscode/
!/examples/

# Re-ignores inside allowlisted folders
.env
.env.*
!.env.example
.mcp.json
*token*
*secret*
.DS_Store
__pycache__/
*.py[cod]
**/.claude/worktrees/
**/.claude/settings.local.json
_meta/today.md
_meta/queue/
