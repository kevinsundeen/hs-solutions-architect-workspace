# Copy to .env (s2 setup does this). Every key is optional; each one unlocks a feature.
# Fathom: s2 fetch / wrap-up
S2_FATHOM_API_KEY=
S2_FATHOM_RECORDED_BY=
# LLM: enrich, context AI summary, smarter transcript names
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Slack DMs from playbooks (else they print)
SLACK_USER_TOKEN=
SLACK_BOT_TOKEN=
# HubSpot library scripts (client folder .env is searched first, then this one)
HUBSPOT_ACCESS_TOKEN=
HUBSPOT_HUB_ID=
# Optional Google Docs MCP (needs its own google-docs-mcp install)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Teamwork (overlay)
TEAMWORK_SITE=
TEAMWORK_API_KEY=
