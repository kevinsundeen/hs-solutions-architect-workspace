{
  "hooks": {
    "PostToolUse": [
      { "matcher": "Write|Edit|MultiEdit|NotebookEdit|Bash",
        "hooks": [{ "type": "command", "command": "python3 \"$CLAUDE_PROJECT_DIR/_meta/scripts/drive-link.py\" hook-post-edit", "timeout": 15 }] },
      { "matcher": "Write|Edit|MultiEdit",
        "hooks": [{ "type": "command", "command": "python3 \"$CLAUDE_PROJECT_DIR/_meta/scripts/test-on-edit.py\"", "timeout": 70 }] }
    ],
    "SessionStart": [
      { "hooks": [{ "type": "command", "command": "python3 \"$CLAUDE_PROJECT_DIR/_meta/scripts/drive-link.py\" hook-session", "timeout": 15 }] }
    ]
  }
}
